RESEND_API_KEY=
MAIL_FROM=GoPort <noreply@contact.goport.uz>
APP_NAME=GoPort
APP_URL=http://localhost:3000
GOOGLE_OAUTH_ID=
GOOGLE_OAUTH_SECRET=

# Create these in the same Lemon Squeezy test-mode store as the API key.
LEMON_SQUEEZY_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_PRO_YEARLY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_TEST_MODE=true
LEMON_SQUEEZY_MONTHLY_AMOUNT_CENTS=299
LEMON_SQUEEZY_YEARLY_AMOUNT_CENTS=1999

# Persistent cloud file sharing. Keep the signing key stable and private.
SHARE_STORAGE_DIR=./pb_data/shares
SHARE_SIGNING_KEY=replace-with-at-least-32-random-bytes
# Every cloud file together; uploads stop at this size to protect the disk.
SHARE_TOTAL_STORAGE_BYTES=21474836480
# Free: 100 MB storage, 25 MB files, kept 1 day (3 at most), 100 downloads a file.
SHARE_FREE_STORAGE_BYTES=104857600
SHARE_FREE_MAX_UPLOAD_BYTES=26214400
SHARE_FREE_DEFAULT_RETENTION_HOURS=24
SHARE_FREE_MAX_RETENTION_HOURS=72
SHARE_FREE_MAX_DOWNLOADS=100
# Different Free accounts that may upload from one IP address per day.
SHARE_FREE_UPLOADERS_PER_IP=5
# Pro: 5 GB storage, 500 MB files, kept 7 days (30 at most), unlimited downloads.
SHARE_PRO_STORAGE_BYTES=5368709120
SHARE_PRO_MAX_UPLOAD_BYTES=524288000
SHARE_PRO_DEFAULT_RETENTION_HOURS=168
SHARE_PRO_MAX_RETENTION_HOURS=720
